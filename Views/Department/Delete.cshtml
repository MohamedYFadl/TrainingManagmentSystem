@model DeptVm
@{
    ViewData["Title"] = "Delete Department";
}

<div class="page-header">
    <div><h1>🗑 Delete Department</h1></div>
    <a asp-action="Index" class="btn btn-ghost">← Back</a>
</div>

<div style="max-width:500px">
    <div class="delete-warning">
        <div class="warn-icon">⚠️</div>
        <h3>Confirm Deletion</h3>
        <p>Are you sure you want to delete <strong>"@Model.Name"</strong>?</p>
        @if (Model.Instructors.Count > 0 || Model.Courses.Count > 0 || Model.Trainees.Count > 0)
        {
            <p style="margin-top:12px;color:var(--danger)">
                This department has @Model.Instructors.Count instructor(s), @Model.Courses.Count course(s), @Model.Trainees.Count trainee(s). Their links will be cleared.
            </p>
        }
    </div>

    <form asp-action="Delete" style="margin-top:16px">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">🗑 Yes, Delete</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>
