@model PaginatedList<DeptVm>
@{
    ViewData["Title"] = "Departments";
}

<div class="page-header">
    <div>
        <h1>🏢 Departments</h1>
        <p>Manage all training departments</p>
    </div>
    <a asp-action="Upsert" class="btn btn-primary">+ New Department</a>
</div>

<div class="card">
    <div class="list-toolbar">
        <form method="get" asp-action="Index" class="search-wrapper" id="searchForm">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" class="search-input" style="border-radius:var(--radius-sm) 0 0 var(--radius-sm);border-right:none" placeholder="Search by name or manager…"
                   value="@ViewBag.Search" id="searchInput" autocomplete="off" />
            <button type="submit" class="btn btn-primary" style="border-radius:0 var(--radius-sm) var(--radius-sm) 0;padding:9px 16px;flex-shrink:0">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <button type="button" class="search-clear" onclick="clearSearch()">×</button>
            }
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <span class="search-tag">"@ViewBag.Search" <a asp-action="Index" style="color:inherit;text-decoration:none">×</a></span>
        }
        <span style="margin-left:auto;font-size:13px;color:var(--text-muted)">@Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")</span>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr><th>#</th><th>Name</th><th>Manager</th><th>Instructors</th><th>Courses</th><th>Trainees</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><div class="empty-icon">🔍</div><p>@(string.IsNullOrEmpty(ViewBag.Search as string) ? "No departments found." : $"No results for \"{ViewBag.Search}\"")</p></div></td></tr>
                }
                @foreach (var d in Model.Data)
                {
                    <tr>
                        <td class="mono text-muted">@d.Id</td>
                        <td class="fw-bold text-primary">@d.Name</td>
                        <td>@(d.Manager ?? "—")</td>
                        <td><span class="badge badge-info">@d.Instructors.Count</span></td>
                        <td><span class="badge badge-purple">@d.Courses.Count</span></td>
                        <td><span class="badge badge-warning">@d.Trainees.Count</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-ghost btn-sm">👁</a>
                                <a asp-action="Upsert" asp-route-id="@d.Id" class="btn btn-outline btn-sm">✏️ Edit</a>
                                <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-danger btn-sm">🗑</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", new {
    Model.PageIndex, Model.TotalPages, Model.TotalCount, Model.PageSize,
        Search = ViewBag.Search as string ?? "", Action = "Index", Controller = "Department"
        })
</div>

<script>
    function clearSearch(){document.getElementById('searchInput').value='';document.getElementById('searchForm').submit();}
</script>
