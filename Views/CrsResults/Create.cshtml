@model CrsResult
@{ ViewData["Title"] = "New Course Result"; }

<div class="page-header">
    <div><h1>📝 New Course Result</h1></div>
    <a asp-action="Index" class="btn btn-ghost">← Back</a>
</div>

<div class="card" style="max-width:600px">
    <div class="card-header"><div class="card-title">Result Details</div></div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="form-group">
                <label asp-for="TraineeId" class="form-label">Trainee</label>
                <select asp-for="TraineeId" asp-items="ViewBag.Trainees" class="form-control">
                    <option value="">-- Select Trainee --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Crs_Id" class="form-label">Course</label>
                <select asp-for="Crs_Id" asp-items="ViewBag.Courses" class="form-control">
                    <option value="">-- Select Course --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Degree" class="form-label">Degree</label>
                <input asp-for="Degree" class="form-control" placeholder="e.g. 85" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">✅ Create Result</button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
