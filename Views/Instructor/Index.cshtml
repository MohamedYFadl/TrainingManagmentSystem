@model PaginatedList<InsViewModel>
@{
    ViewData["Title"] = "Instructors";
}

<div class="page-header">
    <div>
        <h1>👨‍🏫 Instructors</h1>
        <p>Manage all instructors</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ New Instructor</a>
</div>

<div class="card">
    <div class="list-toolbar">
        <form method="get" asp-action="Index" class="search-wrapper" id="searchForm">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" class="search-input" placeholder="Search by course name"
                   value="@ViewBag.Search" id="searchInput" autocomplete="off" />
            <button type="submit" class="search-submit btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <button type="button" class="search-clear" onclick="clearSearch()">×</button>
            }
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <span class="search-tag">"@ViewBag.Search" <a asp-action="Index" style="color:inherit;text-decoration:none">×</a></span>
        }
        <span style="margin-left:auto;font-size:13px;color:var(--text-muted)">@Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")</span>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr><th>#</th><th>Name</th><th>Department</th><th>Course</th><th>Salary</th><th>Address</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><div class="empty-icon">🔍</div><p>@(string.IsNullOrEmpty(ViewBag.Search as string) ? "No instructors found." : $"No results for \"{ViewBag.Search}\"")</p></div></td></tr>
                }
                @foreach (var i in Model.Data)
                {
                    <tr>
                        <td class="mono text-muted">@i.Id</td>
                        <td>
                            <div class="d-flex align-center gap-2">
                                <div class="avatar">
                                <img src="@i.ImgeUrl" alt="@i.InsName" />
                                </div>
                            <span class="fw-bold text-primary">@i.InsName</span>
                        </div>
                    </td>
                    <td>@(i.DepartmentName ?? "—")</td>
                    <td>@(i.CourseName ?? "—")</td>
                    <td class="mono">@(i.InsSalary)</td>
                    <td>@(i.InsAddress ?? "—")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@i.Id" class="btn btn-ghost btn-sm">👁</a>
                            <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-outline btn-sm">✏️ Edit</a>
                            <a asp-action="Delete" asp-route-id="@i.Id" class="btn btn-danger btn-sm">🗑</a>
                        </div>
                    </td>
                </tr>
             }
            </tbody>
        </table>
    </div>

