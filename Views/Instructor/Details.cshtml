@model InsViewModel
@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="row align-items-center">

            <div class="col-md-4 text-center">
                <img src="~/images/@Model.ImgeUrl"
                     class="img-fluid rounded-circle border border-3"
                     style="width:200px; height:200px; object-fit:cover;" />
            </div>

            <div class="col-md-8">
                <h2 class="mb-3">@Model.InsName</h2>

                <p><strong>💰 Salary:</strong> @Model.InsSalary.ToString("C")</p>
                <p><strong>📍 Address:</strong> @Model.InsAddress</p>
                <p><strong>🏢 Department:</strong> @Model.DepartmentName</p>
                <p><strong>📚 Course:</strong> @Model.CourseName</p>

                <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
            </div>

        </div>
    </div>
</div>
