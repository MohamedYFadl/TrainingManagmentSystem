@model PaginatedList<CourseDeptVm>
@{
    ViewData["Title"] = "Courses";
}

<div class="page-header">
    <div><h1>📚 Courses</h1><p>Manage all training courses</p></div>
    <a asp-action="Upsert" class="btn btn-primary">+ New Course</a>
</div>

<div class="card">
    <div class="list-toolbar">
        <form method="get" asp-action="Index" class="search-wrapper" id="searchForm">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" class="search-input" placeholder="Search by course name or department name"
                   value="@ViewBag.Search" id="searchInput" autocomplete="off" />
            <button type="submit" class="search-submit btn btn-primary" >Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <button type="button" class="search-clear" onclick="clearSearch()">×</button>
            }
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <span class="search-tag">"@ViewBag.Search" <a asp-action="Index" style="color:inherit;text-decoration:none">×</a></span>
        }
        <span style="margin-left:auto;font-size:13px;color:var(--text-muted)">@Model.TotalCount record@(Model.TotalCount != 1 ? "s" : "")</span>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr><th>#</th><th>Name</th><th>Department</th><th>Hours</th><th>Degree</th><th>Min Degree</th><th>Instructors</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Data.Any())
                {
                    <tr><td colspan="8"><div class="empty-state"><div class="empty-icon">📚</div><p>No courses found.</p></div></td></tr>
                }
                @foreach (var c in Model.Data)
                {
                    <tr>
                        <td class="mono text-muted">@c.Id</td>
                        <td class="fw-bold text-primary">@c.Name</td>
                        <td>@(c.DepartmentName ?? "—")</td>
                        <td class="mono">@(c.Hours.ToString() ?? "—")</td>
                        <td class="mono">@(c.Degree)</td>
                        <td class="mono">@(c.MinDegree)</td>
                        <td><span class="badge badge-info">@c.Instructors?.Count</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-ghost btn-sm">👁</a>
                                <a asp-action="Upsert" asp-route-id="@c.Id" class="btn btn-outline btn-sm">✏️ Edit</a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">🗑</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", new {
    Model.PageIndex, Model.TotalPages, Model.TotalCount, Model.PageSize,
        Search = ViewBag.Search as string ?? "", Action = "Index", Controller = "Course"
        }) 
</div>

